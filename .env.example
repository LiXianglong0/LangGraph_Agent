# 智谱开放平台 API Key：https://open.bigmodel.cn/
# 也可在前端侧栏填写后点「保存到 .env」
ZHIPU_API_KEY=your_api_key_here
ZHIPU_MODEL=glm-4-flash
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_TEMPERATURE=0.7

# ---------- PostgreSQL（会话 / checkpoint 持久化）----------
# 未配置时使用进程内 MemorySaver；配置后 F5 / 重启后端均可恢复 thread 历史
# 本机 WSL（deploy/setup-wsl-pg-agentdb.sh）：用户 admin / 密码 admin / 库 agentDB
DATABASE_URL=postgresql://admin:admin@127.0.0.1:5432/agentDB
# 远程库示例：
# DATABASE_URL=postgresql://postgres:your_password@172.30.105.51:5432/langgraph_agent

# ---------- CSS / SAAF（AGENT4 可售物料；先登录取 certificate）----------
# CSS_LOGIN_URL=https://dms.aosmith.com.cn/api/baseServer/baseLoginService/login
# CSS_DOMAIN=https://dms.aosmith.com.cn
# CSS_USER_NAME=AGENT_INF
# CSS_PASSWORD=your_md5_or_password
# CSS_CERT_TTL_SEC=1800
# 物料可售诊断 diagnoseMaterialSellable（可售 + 不可售原因）
# CSS_DIAGNOSE_URL=https://dms.aosmith.com.cn/api/orderInterfaceServer/errorMsgInfoService/diagnoseMaterialSellable
# QAD 客户+物料是否配置价格
# QAD_BATCH_GET_QAD58_URL=http://172.30.109.112:8015/api/QadRealTime/BatchGetQad58
# QAD 销售订单状态（billNo：8 位字母数字）
# QAD_SALES_ORDER_STATUS_URL=http://172.30.109.112:8015/Qad/SalesOrderStatusWS
# CSS 快码字典（经验目录见 data/css_lookup_catalog.json）
# CSS_LOOKUP_URL=https://dms.aosmith.com.cn/api/baseServer/baseLookupValuesService/find

# ---------- RAGFlow（可选；同仓 compose 时与 Agent 同网络）----------
# 是否默认启用知识库检索工具
RAGFLOW_ENABLED=false
# 浏览器访问 RAGFlow：http://localhost:8088
# Agent 跑在 Docker 总栈内时用服务名（deploy 已默认写入）：
#   RAGFLOW_BASE_URL=http://ragflow-cpu
# Agent 跑在宿主机、RAGFlow 在 Docker 映射 8088 时：
RAGFLOW_BASE_URL=http://127.0.0.1:8088
# 在 RAGFlow 控制台创建的 API Key
RAGFLOW_API_KEY=
# 数据集 ID，多个用英文逗号分隔
RAGFLOW_DATASET_IDS=
